# Flask
SECRET_KEY=0355aacacba6986f83714fefb3a98b2101ec9c309e38ba3cdec2af7ea9264086

# Database (defaults to local SQLite if left unset)
# DATABASE_URL=postgresql://user:password@localhost:5432/data_leak_detector

# ---- Data sources -------------------------------------------------------
# live = free real APIs (default) | mock = offline fake data | both
SCRAPER_MODE=live

# ---- Real-time scanning -------------------------------------------------
ENABLE_SCHEDULER=true
SCAN_INTERVAL_MINUTES=30     # keep >= 30 to stay inside free API rate limits
FEED_LOOKBACK_DAYS=90

# ---- Optional (all FREE to obtain; the app works without them) ----------
# GitHub: github.com > Settings > Developer settings > Personal access tokens (no scopes needed)
GITHUB_TOKEN=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
# Claude AI triage. Without it the built-in rule engine is used instead.
ANTHROPIC_API_KEY=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
ANTHROPIC_MODEL=claude-haiku-5-5
# Let Claude search the live web for your email/domain using YOUR key.
# Costs API credits and sends the email/domain to Anthropic. Leave false unless you want it.
AI_WEB_SEARCH=true
# Privacy-first default: Claude does not receive leak snippets for triage.
ALLOW_CLOUD_AI_TRIAGE=true
ANTHROPIC_SEARCH_MODEL=claude-sonnet-5-5

# Show every step in the console (true/false)
CONSOLE_VERBOSE=true

# ---- Email alerts (leave MAIL_SERVER blank = alerts printed to console) --
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=alerts@dataleakdetector.local

FUZZY_MATCH_THRESHOLD=0.85

# REQUIRED: generate once with python generate_encryption_key.py
# Back up this key; losing it makes encrypted data unrecoverable.
DATA_ENCRYPTION_KEY=oVm92Oh_mD5_XwTJ1e2HjxTdZ0ZUWebJLVEaSXLiwYU=

# Optional: sends monitored phone numbers to Anthropic public web search. Requires Cloud AI checkbox and AI_WEB_SEARCH=true.
PHONE_WEB_SEARCH=true